{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curvelet",
  "version": "0.2.2",
  "identifier": "com.curvelet.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace @math/web",
    "beforeBuildCommand": "npm run build --workspace @math/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Curvelet",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Graphing calculator with symbolic math",
    "longDescription": "Graph functions, solve and simplify with a full symbolic engine, build geometry, and make worksheets, all offline.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 215
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQzg2MUU0QTkyRkQzNDAKUldSQTB5K3A1R0hJUEJ2aENJdjZKaEZ6alFJckt5SWs4VnRQTFAzc2R4ZUNqcWtNWmRiam1Tb2UK",
      "endpoints": [
        "https://github.com/aylynuw/curvelet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
